# YouTube Data API v3 Configuration
# Get your free API key from: https://console.cloud.google.com/apis/credentials
#
# Steps to get your API key:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project (or select existing)
# 3. Enable "YouTube Data API v3"
# 4. Go to Credentials → Create Credentials → API Key
# 5. Copy the API key and paste it below
# 6. Rename this file to .env (remove .example)
#
# Free tier: 10,000 units/day (more than enough for this app)
# Each video search costs 100 units, so you can do ~100 searches per day

VITE_YOUTUBE_API_KEY=your_api_key_here

# News API Configuration (Optional)
# Get your free API key from: https://newsapi.org/register
#
# Steps to get your API key:
# 1. Go to https://newsapi.org/register
# 2. Sign up with your email
# 3. Copy the API key from your account dashboard
# 4. Paste it below
#
# Free tier: 100 requests/day
# Without this, the app will use fallback news articles

VITE_NEWS_API_KEY=your_news_api_key_here
